# =====================================================================
# Copy to .env and adjust as needed
# =====================================================================

# PostgreSQL (results store)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fda_signals
POSTGRES_USER=fda
POSTGRES_PASSWORD=fda

# HDFS
HDFS_NAMENODE=hdfs://localhost:9000
HDFS_USER=root

# Hive
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_DATABASE=fda_pharma

# Spark
SPARK_MASTER=spark://localhost:7077
SPARK_APP_NAME=fda_signal_detection

# FAERS data
FAERS_BASE_URL=https://download.open.fda.gov/drug/event
FAERS_DOWNLOAD_DIR=./data/raw
FAERS_PROCESSED_DIR=./data/processed

# Signal detection thresholds (FDA standard)
SIGNAL_PRR_THRESHOLD=2.0
SIGNAL_ROR_THRESHOLD=2.0
SIGNAL_MIN_CASES=3

# Backtest cutoff: train on data <= this date, predict beyond it
BACKTEST_TRAIN_CUTOFF=2020-12-31
